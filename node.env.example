# Konfigurasi node sensor Enviro Monitor
# Salin menjadi node.env lalu sesuaikan.

# Endpoint ingest (wajib)
ENVIRO_URL=https://devel-ai.ub.ac.id/enviro/api/ingest
ENVIRO_API_KEY=ganti-dengan-ingest-api-key-anda

# Identitas perangkat, tampil di dashboard
ENVIRO_DEVICE_ID=node-01

# Interval baca/kirim dalam detik
ENVIRO_INTERVAL=5

# Sumber data: mock | serial | stdin | file
ENVIRO_SOURCE=mock

# Untuk --source serial
# ENVIRO_SERIAL_PORT=/dev/ttyUSB0
# ENVIRO_SERIAL_BAUD=115200

# Untuk --source file
# ENVIRO_FILE=/var/lib/enviro-node/latest.json

# Antrean saat jaringan putus
ENVIRO_QUEUE=/var/lib/enviro-node/queue.jsonl

# DEBUG | INFO | WARNING | ERROR
ENVIRO_LOG_LEVEL=INFO
